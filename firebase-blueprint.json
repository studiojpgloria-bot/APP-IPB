{
  "entities": {
    "PlatformUser": {
      "title": "PlatformUser",
      "description": "User account and role mapping (owner or gestor) linked to a specific churchId",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "gestor", "membro"] },
        "churchId": { "type": "string" },
        "churchSlug": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "pending", "revoked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global platform configuration and branding",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "tagline": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appName"]
    },
    "ChurchTenant": {
      "title": "ChurchTenant",
      "description": "Public information, slug, location, status, and authorized managers of a church",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "status": { "type": "string", "enum": ["ativa", "bloqueada", "pendente"] },
        "themeColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "ownerUid": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "managerUids": { "type": "array", "items": { "type": "string" } },
        "managerEmails": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "slug", "name", "city", "state", "status"]
    },
    "SubcollectionItem": {
      "title": "SubcollectionItem",
      "description": "Item inside boletins, escalas, aniversariantes, banners, lideranca, or cultos subcollections",
      "type": "object",
      "properties": {
        "id": { "type": "string" }
      },
      "required": ["id"]
    },
    "ChurchInvite": {
      "title": "ChurchInvite",
      "description": "Team invitation document inside /churches/{churchId}/convites/{inviteEmail}",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "churchId": { "type": "string" },
        "churchSlug": { "type": "string" },
        "churchName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "editor"] },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "emailSent": { "type": "boolean" },
        "invitedBy": { "type": "string" },
        "invitedAt": { "type": "string" },
        "lastSentAt": { "type": "string" },
        "acceptedAt": { "type": "string" },
        "acceptedUid": { "type": "string" }
      },
      "required": ["email", "churchId", "role", "status"]
    }
  },
  "firestore": {
    "/platform_config/{configId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Global branding settings for the multi-church platform"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PlatformUser" },
      "description": "User role and churchId assignment"
    },
    "/churches/{churchId}": {
      "schema": { "$ref": "#/entities/ChurchTenant" },
      "description": "Registered churches on the platform"
    },
    "/churches/{churchId}/convites/{inviteEmail}": {
      "schema": { "$ref": "#/entities/ChurchInvite" },
      "description": "Team invitations for church administrators and editors"
    },
    "/churches/{churchId}/boletins/{itemId}": {
      "schema": { "$ref": "#/entities/SubcollectionItem" },
      "description": "Weekly bulletins of a church"
    },
    "/churches/{churchId}/escalas/{itemId}": {
      "schema": { "$ref": "#/entities/SubcollectionItem" },
      "description": "Deacon schedules of a church"
    },
    "/churches/{churchId}/aniversariantes/{itemId}": {
      "schema": { "$ref": "#/entities/SubcollectionItem" },
      "description": "Member birthdays of a church"
    },
    "/churches/{churchId}/banners/{itemId}": {
      "schema": { "$ref": "#/entities/SubcollectionItem" },
      "description": "Promotional banners of a church"
    },
    "/churches/{churchId}/lideranca/{itemId}": {
      "schema": { "$ref": "#/entities/SubcollectionItem" },
      "description": "Pastoral leadership and elders/deacons of a church"
    },
    "/churches/{churchId}/cultos/{itemId}": {
      "schema": { "$ref": "#/entities/SubcollectionItem" },
      "description": "Worship schedules of a church"
    }
  }
}
