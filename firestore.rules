rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isPlatformOwner() {
      return isVerifiedEmail() && (
        request.auth.token.email == 'studiojpgloria@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' &&
          request.auth.token.email == 'studiojpgloria@gmail.com'
        )
      );
    }

    function isChurchActive(churchId) {
      return exists(/databases/$(database)/documents/churches/$(churchId)) &&
             get(/databases/$(database)/documents/churches/$(churchId)).data.status == 'ativa';
    }

    // Nível Administrador da Igreja: Acesso total (dados da igreja, cultos, liderança, equipe e publicações)
    // Convites por e-mail exigem e-mail verificado (request.auth.token.email_verified == true)
    function isChurchAdmin(churchId) {
      return isAuthenticated() && (
        isPlatformOwner() ||
        (
          exists(/databases/$(database)/documents/churches/$(churchId)) &&
          (
            get(/databases/$(database)/documents/churches/$(churchId)).data.ownerUid == request.auth.uid ||
            (
              ('adminUids' in get(/databases/$(database)/documents/churches/$(churchId)).data) &&
              (request.auth.uid in get(/databases/$(database)/documents/churches/$(churchId)).data.adminUids)
            ) ||
            (
              isVerifiedEmail() &&
              ('adminEmails' in get(/databases/$(database)/documents/churches/$(churchId)).data) &&
              (request.auth.token.email in get(/databases/$(database)/documents/churches/$(churchId)).data.adminEmails)
            ) ||
            (
              isVerifiedEmail() &&
              exists(/databases/$(database)/documents/churches/$(churchId)/convites/$(request.auth.token.email)) &&
              get(/databases/$(database)/documents/churches/$(churchId)/convites/$(request.auth.token.email)).data.role == 'admin'
            ) ||
            (
              !('adminEmails' in get(/databases/$(database)/documents/churches/$(churchId)).data) &&
              (
                (request.auth.uid in get(/databases/$(database)/documents/churches/$(churchId)).data.managerUids) ||
                (
                  isVerifiedEmail() &&
                  (request.auth.token.email in get(/databases/$(database)/documents/churches/$(churchId)).data.managerEmails)
                )
              )
            )
          )
        )
      );
    }

    // Nível Editor da Igreja (ou Administrador): Pode criar/editar/publicar boletins, escalas, aniversariantes e banners
    // Convites por e-mail exigem e-mail verificado (request.auth.token.email_verified == true)
    function isChurchEditor(churchId) {
      return isAuthenticated() && (
        isChurchAdmin(churchId) ||
        (
          exists(/databases/$(database)/documents/churches/$(churchId)) &&
          (
            (
              ('editorUids' in get(/databases/$(database)/documents/churches/$(churchId)).data) &&
              (request.auth.uid in get(/databases/$(database)/documents/churches/$(churchId)).data.editorUids)
            ) ||
            (
              isVerifiedEmail() &&
              ('editorEmails' in get(/databases/$(database)/documents/churches/$(churchId)).data) &&
              (request.auth.token.email in get(/databases/$(database)/documents/churches/$(churchId)).data.editorEmails)
            ) ||
            (
              isVerifiedEmail() &&
              exists(/databases/$(database)/documents/churches/$(churchId)/convites/$(request.auth.token.email))
            ) ||
            (request.auth.uid in get(/databases/$(database)/documents/churches/$(churchId)).data.managerUids) ||
            (
              isVerifiedEmail() &&
              (request.auth.token.email in get(/databases/$(database)/documents/churches/$(churchId)).data.managerEmails)
            )
          )
        )
      );
    }

    // 1. Configuração global da plataforma (ex: nome genérico "Minha Igreja")
    match /platform_config/{configId} {
      allow read: if true;
      allow write: if isPlatformOwner();
    }

    // 2. Coleção de usuários e papéis (owner / gestor)
    // Editável apenas pelo próprio usuário (sem escalar para owner) ou pelo owner da plataforma
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isPlatformOwner() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
      allow create: if isAuthenticated() && (
        isPlatformOwner() ||
        (
          request.auth.uid == userId &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.role == 'gestor'
        )
      );
      allow update: if isAuthenticated() && (
        isPlatformOwner() ||
        (
          request.auth.uid == userId &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.role != 'owner'
        )
      );
      allow delete: if isPlatformOwner();
    }

    // 3. Coleção de Igrejas (churches/{churchId})
    // Leitura pública APENAS de igrejas com status == 'ativa' (ou membro da equipe / owner)
    // Alteração de dados institucionais e equipe APENAS por Administrador da igreja ou Owner
    match /churches/{churchId} {
      allow read: if resource.data.status == 'ativa' || isChurchEditor(churchId);
      allow create: if isAuthenticated() && (
        isPlatformOwner() ||
        (
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.status == 'ativa'
        )
      );
      allow update: if (
        isChurchAdmin(churchId) && (
          isPlatformOwner() ||
          request.resource.data.status == resource.data.status
        )
      ) || (
        // Permite que o convidado (Editor ou Admin) com e-mail verificado vincule automaticamente seu UID ao entrar
        isVerifiedEmail() &&
        isChurchEditor(churchId) &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.slug == resource.data.slug &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.ownerUid == resource.data.ownerUid
      );
      allow delete: if isPlatformOwner();

      // Subcoleção de Convites da Equipe (churches/{churchId}/convites/{inviteEmail})
      // Apenas Administradores da igreja ou Owner criam/removem convites;
      // O próprio convidado com e-mail verificado pode ler e aceitar o convite do seu e-mail.
      match /convites/{inviteEmail} {
        allow read: if isChurchAdmin(churchId) || (
          isVerifiedEmail() &&
          request.auth.token.email == inviteEmail
        );
        allow create, delete: if isChurchAdmin(churchId);
        allow update: if isChurchAdmin(churchId) || (
          isVerifiedEmail() &&
          request.auth.token.email == inviteEmail &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.churchId == resource.data.churchId
        );
      }

      // Subcoleções de Publicação (boletins, escalas, aniversariantes, banners): Administradores e Editores
      match /boletins/{itemId} {
        allow read: if isChurchActive(churchId) || isChurchEditor(churchId);
        allow write: if isChurchEditor(churchId);
      }

      match /escalas/{itemId} {
        allow read: if isChurchActive(churchId) || isChurchEditor(churchId);
        allow write: if isChurchEditor(churchId);
      }

      match /aniversariantes/{itemId} {
        allow read: if isChurchActive(churchId) || isChurchEditor(churchId);
        allow write: if isChurchEditor(churchId);
      }

      match /banners/{itemId} {
        allow read: if isChurchActive(churchId) || isChurchEditor(churchId);
        allow write: if isChurchEditor(churchId);
      }

      // Subcoleções Institucionais (lideranca, cultos): Apenas Administradores ou Owner
      match /lideranca/{itemId} {
        allow read: if isChurchActive(churchId) || isChurchEditor(churchId);
        allow write: if isChurchAdmin(churchId);
      }

      match /cultos/{itemId} {
        allow read: if isChurchActive(churchId) || isChurchEditor(churchId);
        allow write: if isChurchAdmin(churchId);
      }
    }

    // 4. Coleções legadas (apenas Owner pode limpar/gerenciar)
    match /church_data/{moduleId} {
      allow read: if isPlatformOwner();
      allow write: if isPlatformOwner();
    }

    match /church_registry/{docId} {
      allow read: if isPlatformOwner();
      allow write: if isPlatformOwner();
    }

    match /church_managers/{managerUid} {
      allow read: if isAuthenticated() && (request.auth.uid == managerUid || isPlatformOwner());
      allow write: if isPlatformOwner();
    }
  }
}
